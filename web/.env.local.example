# Project URL do Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable/anon key do Supabase (Project Settings > API) — segura para expor no browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role / secret key do Supabase — NUNCA expor no browser, só uso server-side.
# Ainda depende do usuário conseguir essa chave no painel do Supabase (Project Settings > API);
# não é necessária para o scaffolding atual, só para operações server-side privilegiadas futuras.
SUPABASE_SERVICE_ROLE_KEY=

# Senha dos alunos de demo criados por scripts/seed-demo.mjs (só para dev/demo).
DEMO_STUDENT_PASSWORD=

# Frase que criptografa os backups (npm run backup). Guarde uma cópia fora deste PC.
BACKUP_PASSPHRASE=
# Opcionais: pasta dos backups (padrão ~/TracklyBackups) e quantos manter (padrão 8).
# BACKUP_DIR=
# BACKUP_KEEP=8

# SyncPay — assinatura mensal do COACH com o Trackly (só servidor; nunca NEXT_PUBLIC).
# Credenciais da API de parceiro: com elas o webhook confere o status na SyncPay em vez de confiar
# no corpo recebido. Sem elas (dev), o corpo é aplicado e o log avisa que não foi verificado.
# SYNCPAY_CLIENT_ID=
# SYNCPAY_CLIENT_SECRET=
# Segmento secreto da URL do webhook: cadastre na SyncPay
#   https://<seu-dominio>/api/webhooks/syncpay/<SYNCPAY_WEBHOOK_SECRET>
# SYNCPAY_WEBHOOK_SECRET=
# Opção "Cartão recorrente": link de pagamento/checkout hospedado da SyncPay (https), aberto em
# nova aba na tela /coach/assinatura. Vazio = a opção aparece "Em breve".
# SYNCPAY_COACH_CHECKOUT_URL=
# Opção "Pix Automático": token (UUID) do plano da SyncPay criado com billing_method=pix_automatico.
# Precisa também de SYNCPAY_CLIENT_ID/SECRET. Faltando qualquer um = a opção aparece "Em breve".
# SYNCPAY_PIX_PLAN_TOKEN=
# SÓ PARA TESTE contra um mock local da API (ex.: http://127.0.0.1:8799). Aceita https ou http em
# localhost/127.0.0.1; qualquer outro valor é ignorado. Em produção, deixe sem definir
# (padrão https://api.syncpayments.com.br).
# SYNCPAY_API_BASE=
